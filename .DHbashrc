# Git Related
alias gs="git status"
alias gshowfile="git diff-tree --no-commit-id --name-only -r" #add commit hash after.
alias gb="git branch"
alias gl="git log"
alias gl1="git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all"
alias gl10="git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all -10"
alias gpl="git pull"
alias gps="git push"
alias gd="git diff"
alias gdcache="git diff --cached"
alias gfa="git fetch -a"

# [.gitconfig] manually enter the following commands in terminal
# git config --global alias.co checkout
# git config --global alias.add-commit '!git add -A && git commit'

# Dir Related (varies according to device)
alias cdProjects="cd /Users/user/self/projects"
alias cdSelf="cd /Users/user/self"
alias cdHustleProjects="cd /Users/user/hustle/projects"
# alias cdHookedProjects="cd /Users/user/hooked/projects"
# alias codeNotes="code /Users/user/company/doc"

# Shell Related
alias ll="ls -1Ap"
export LC_ALL=zh_TW.UTF-8

function parse_git_branch {
   git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

# Get Python virtual env name
function get_virtual_env {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        echo "($(basename $VIRTUAL_ENV)) "
    fi
}

# Modified PS1 to include virtual env before username
PS1="\[\e[0m\]\$(get_virtual_env)\[\e[0;92m\]\u \[\e[0;93m\]\w\[\e[0m\] \[\e[0;96m\]\$(parse_git_branch)\[\e[0m\] \\$ "

# Homebrew
export HOMEBREW_NO_INSTALL_ROSETTA=1
